      "css": ".ds-input{min-height:48px;width:320px;resize:none;padding:12px 16px;border:1px solid #96A49D;border-radius:4px;background:#F4F7F5;color:#121A17;font:400 16px 'Noto Sans KR',sans-serif}.ds-input::placeholder{color:#58645F}.ds-input:focus{outline:none;border-color:#0E3B34;background:#fff;box-shadow:0 0 0 2px rgba(14,59,52,.25)}"
