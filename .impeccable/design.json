      "description": "LED glass showing live orchestration state.",
      "html": "<div class=\"ds-led\"><i></i><span>법령 검색 중</span></div>",
      "css": ".ds-led{display:inline-flex;align-items:center;gap:10px;height:36px;padding:0 12px;border-radius:3px;background-color:#110D0B;background-image:radial-gradient(rgba(92,38,28,.55) .7px,transparent .9px);background-size:3px 3px;box-shadow:inset 0 1px 3px rgba(0,0,0,.7);min-width:220px}.ds-led i{width:8px;height:8px;border-radius:50%;background:#FF5333;box-shadow:0 0 6px rgba(255,83,51,.8);animation:ds-blink 1s steps(2,jump-none) infinite}.ds-led span{color:#FF5333;text-shadow:0 0 6px rgba(255,83,51,.55);font:400 15px 'DotGothic16','Gothic A1',monospace;letter-spacing:.06em}@keyframes ds-blink{50%{opacity:.3}}"
    },
