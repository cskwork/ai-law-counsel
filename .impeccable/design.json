      "name": "Commit Button (접수)",
      "kind": "button",
      "refersTo": "button-commit",
      "description": "The one filled action: submit the question.",
      "html": "<button class=\"ds-btn-commit\">접수 <svg viewBox=\"0 0 16 16\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 8h9.5M8.5 4 12.5 8l-4 4\"/></svg></button>",
      "css": ".ds-btn-commit{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 20px;border:0;border-radius:4px;background:#0E3B34;color:#F0F6F3;font:700 15px 'Gothic A1',sans-serif;cursor:pointer;transition:background-color .15s,transform .15s}.ds-btn-commit:hover{background:#144E45}.ds-btn-commit:active{transform:translateY(1px)}.ds-btn-commit:focus-visible{outline:2px solid #1D5FD1;outline-offset:2px}"
    },
